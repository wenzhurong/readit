{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "readit",
  "version": "0.1.0",
  "identifier": "com.mmy420.readit",
  "build": {
    "frontendDist": "../static"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "readit",
        "width": 960,
        "height": 720
      }
    ],
    "security": {
      "csp": "default-src 'self' readit: http://readit.localhost; connect-src ipc: http://ipc.localhost; img-src 'self' data: blob: readit: http://readit.localhost; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/icon.png",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "14.0"
    }
  }
}
