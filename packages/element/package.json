{
  "name": "@readit/element",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./types": "./src/types.ts",
    "./styles": "./src/styles.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "vitest run",
    "test:perf": "vitest run --config vitest.perf.config.ts",
    "typecheck": "tsc --noEmit",
    "gen:theme-css": "vite-node scripts/gen-theme-css.ts"
  },
  "dependencies": {
    "@readit/core": "0.0.0",
    "@readit/editor": "0.0.0",
    "dompurify": "3.4.13",
    "github-markdown-css": "5.9.0"
  },
  "devDependencies": {
    "@readit/highlight": "0.0.0",
    "@readit/mermaid": "0.0.0",
    "@types/node": "24.10.1",
    "happy-dom": "20.11.2",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=22"
  }
}
