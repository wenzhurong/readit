{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "NodeNext",
    "moduleResolution": "nodenext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "rootDir": "../..",
    "outDir": "./dist/types",
    "types": []
  },
  "include": [
    "src/**/*.ts",
    "../core/src/**/*.ts",
    "../math/src/**/*.ts",
    "../element/src/**/*.ts",
    "../highlight/src/**/*.ts",
    "../editor/src/**/*.ts",
    "../find/src/**/*.ts",
    "../mermaid/src/**/*.ts"
  ]
}
